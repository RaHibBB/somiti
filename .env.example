# Neon Postgres connection string (pooled is fine)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/samiti?sslmode=require"

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Vercel Blob (receipt images). Created automatically when you add a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=""

# Google service account key JSON, base64-encoded: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=""
# The mirror sheet's ID (from its URL). Share the sheet with the service account email as Editor.
SHEET_ID=""

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# Email for "পাসওয়ার্ড ভুলে গেছেন?" (free with Gmail: create an App Password at
# https://myaccount.google.com/apppasswords — needs 2-Step Verification on that Google account).
# Without these in local dev, reset emails are printed to the server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""   # e.g. "সমিতি <yoursamiti@gmail.com>" (defaults to SMTP_USER)

# Public site address used in reset links. On Vercel this falls back to the production domain automatically.
APP_URL=""
